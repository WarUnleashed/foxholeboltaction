      <selectionEntryGroups><selectionEntryGroup id="2885b267-e42f-549a-835d-c3948ce616b7" name="Experience (choose one)" hidden="false"><constraints><constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="min" id="3ffb9a15-a948-5796-b0fe-6ad9d53d767c" /><constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" type="max" id="71d7222a-cf27-5241-9227-01931aa46aa8" /></constraints><selectionEntries><selectionEntry id="7e418340-74bf-5c98-a6af-bc4b13c3adc5" name="Inexperienced" hidden="false" collective="false" import="true" type="upgrade">
